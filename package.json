{
    "name": "streamdeck-kasa-plugin",
    "version": "0.3.0",
    "description": "Turn TP-Link Kasa smart switches and plugs on/off from a Stream Deck key, plus Windows desktop shortcuts for the same switches.",
    "keywords": [
        "stream-deck",
        "streamdeck",
        "elgato",
        "elgato-stream-deck",
        "kasa",
        "tp-link",
        "tplink",
        "smart-plug",
        "smart-switch",
        "smart-home",
        "home-automation",
        "desktop-shortcut"
    ],
    "author": "paul",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "build:toggle": "rollup -c rollup.toggle.mjs",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.caffecter.kasa\"",
        "discover": "node ./scripts/discover.ts",
        "toggle": "node ./dist/kasa-toggle.mjs",
        "test": "node --test ./test/kasa.test.ts"
    },
    "devDependencies": {
        "@elgato/cli": "^1.7.4",
        "@elgato/utils": "^0.4.5",
        "@rollup/plugin-commonjs": "^28.0.0",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~20.15.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.1.0",
        "tplink-smarthome-api": "^5.0.0"
    }
}
