# Node.js
node_modules/

# Stream Deck files
*.sdPlugin/bin
*.sdPlugin/logs

# JetBrains IDE project files (local editor state, not project source)
.idea/

# Desktop-toggle CLI build output (npm run build:toggle regenerates this).
